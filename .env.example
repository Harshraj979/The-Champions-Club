# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL="postgresql://club:club@localhost:5432/champions_club"
# Signs staff session tokens. Use a long random string in production.
AUTH_SECRET="change-me"
# Seed-only: the first staff account created by `npm run db:seed`.
SEED_STAFF_PASSWORD="champions"
SEED_STAFF_PIN="2468"

# Google sign-in (staff accounts)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Razorpay payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
