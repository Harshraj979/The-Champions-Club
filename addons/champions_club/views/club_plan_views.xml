<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_plan_list" model="ir.ui.view">
        <field name="name">club.plan.list</field>
        <field name="model">club.plan</field>
        <field name="arch" type="xml">
            <list string="Membership Plans">
                <field name="name"/><field name="code"/>
                <field name="court_price"/><field name="shop_discount"/>
                <field name="bar_discount"/><field name="validity_days"/>
            </list>
        </field>
    </record>
    <record id="view_club_plan_form" model="ir.ui.view">
        <field name="name">club.plan.form</field>
        <field name="model">club.plan</field>
        <field name="arch" type="xml">
            <form string="Membership Plan">
                <sheet><group>
                    <field name="name"/><field name="code"/>
                    <field name="court_price"/><field name="shop_discount"/>
                    <field name="bar_discount"/><field name="validity_days"/>
                    <field name="active"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_club_plan" model="ir.actions.act_window">
        <field name="name">Membership Plans</field>
        <field name="res_model">club.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
