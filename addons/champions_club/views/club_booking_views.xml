<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_court_list" model="ir.ui.view">
        <field name="name">club.court.list</field>
        <field name="model">club.court</field>
        <field name="arch" type="xml">
            <list string="Courts">
                <field name="name"/><field name="sport"/>
                <field name="walkin_price"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_club_court_form" model="ir.ui.view">
        <field name="name">club.court.form</field>
        <field name="model">club.court</field>
        <field name="arch" type="xml">
            <form string="Court">
                <sheet><group>
                    <field name="name"/><field name="sport"/>
                    <field name="walkin_price"/><field name="active"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_club_court" model="ir.actions.act_window">
        <field name="name">Courts</field>
        <field name="res_model">club.court</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_club_booking_list" model="ir.ui.view">
        <field name="name">club.booking.list</field>
        <field name="model">club.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="date"/><field name="start_time"/>
                <field name="court_id"/><field name="partner_id"/>
                <field name="walkin_name"/><field name="booking_type"/>
                <field name="price"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_club_booking_form" model="ir.ui.view">
        <field name="name">club.booking.form</field>
        <field name="model">club.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_done" type="object" string="Mark done"
                            class="btn-primary" invisible="state != 'booked'"/>
                    <button name="action_cancel" type="object" string="Cancel booking"
                            invisible="state != 'booked'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="booked,done,cancelled"/>
                </header>
                <sheet><group>
                    <field name="court_id"/><field name="booking_type"/>
                    <field name="date"/><field name="start_time"/>
                    <field name="partner_id"/>
                    <field name="walkin_name" invisible="partner_id"/>
                    <field name="partner_ids" widget="many2many_tags"
                           invisible="booking_type != 'friday_social'"/>
                    <field name="price"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="view_club_booking_calendar" model="ir.ui.view">
        <field name="name">club.booking.calendar</field>
        <field name="model">club.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings" date_start="start_datetime"
                      date_stop="stop_datetime" color="court_id" mode="week">
                <field name="court_id"/><field name="partner_id"/>
            </calendar>
        </field>
    </record>
    <record id="action_club_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">club.booking</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
