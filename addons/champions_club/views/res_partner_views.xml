<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_club" model="ir.ui.view">
        <field name="name">res.partner.form.club</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <group string="Champions Club Membership">
                    <field name="club_plan_id"/>
                    <field name="member_since"/>
                    <field name="membership_expiry"/>
                    <field name="is_member" readonly="1"/>
                    <field name="membership_state" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="action_club_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('club_plan_id', '!=', False)]</field>
    </record>
</odoo>
