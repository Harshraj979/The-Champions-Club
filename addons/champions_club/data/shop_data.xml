<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product categories: discounts are per category, per plan -->
    <record id="categ_gear" model="product.category">
        <field name="name">Gear</field>
    </record>
    <record id="categ_bar" model="product.category">
        <field name="name">Bar and Cafe</field>
    </record>
    <record id="pos_categ_shop" model="pos.category">
        <field name="name">Shop</field>
    </record>
    <record id="pos_categ_bar" model="pos.category">
        <field name="name">Bar and Cafe</field>
    </record>

    <!-- One pricelist per plan. POS and Sales read the customer's pricelist,
         so the member discount applies on its own - nobody types it in. -->
    <record id="pricelist_walkin" model="product.pricelist">
        <field name="name">Walk-in</field>
    </record>
    <record id="pricelist_gold" model="product.pricelist">
        <field name="name">Gold</field>
    </record>
    <record id="pricelist_gold_gear" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_gold"/>
        <field name="applied_on">2_product_category</field>
        <field name="categ_id" ref="categ_gear"/>
        <field name="compute_price">percentage</field>
        <field name="percent_price">-15</field>
        <field name="base">list_price</field>
    </record>
    <record id="pricelist_gold_bar" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_gold"/>
        <field name="applied_on">2_product_category</field>
        <field name="categ_id" ref="categ_bar"/>
        <field name="compute_price">percentage</field>
        <field name="percent_price">-15</field>
        <field name="base">list_price</field>
    </record>
    <record id="pricelist_silver" model="product.pricelist">
        <field name="name">Silver</field>
    </record>
    <record id="pricelist_silver_gear" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_silver"/>
        <field name="applied_on">2_product_category</field>
        <field name="categ_id" ref="categ_gear"/>
        <field name="compute_price">percentage</field>
        <field name="percent_price">-10</field>
        <field name="base">list_price</field>
    </record>
    <record id="pricelist_silver_bar" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_silver"/>
        <field name="applied_on">2_product_category</field>
        <field name="categ_id" ref="categ_bar"/>
        <field name="compute_price">percentage</field>
        <field name="percent_price">-10</field>
        <field name="base">list_price</field>
    </record>
    <record id="pricelist_junior" model="product.pricelist">
        <field name="name">Junior</field>
    </record>
    <record id="pricelist_junior_gear" model="product.pricelist.item">
        <field name="pricelist_id" ref="pricelist_junior"/>
        <field name="applied_on">2_product_category</field>
        <field name="categ_id" ref="categ_gear"/>
        <field name="compute_price">percentage</field>
        <field name="percent_price">-5</field>
        <field name="base">list_price</field>
    </record>
    <!-- Junior bar discount is 0%, so no bar rule: full price. -->

    <!-- Gear: one stock for counter and online, it is the same shelf -->
    <record id="prod_racket" model="product.template">
        <field name="name">Tennis Racket</field><field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">4999</field><field name="categ_id" ref="categ_gear"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_shop')])]"/>
    </record>
    <record id="prod_balls" model="product.template">
        <field name="name">Tennis Balls (can of 3)</field><field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">549</field><field name="categ_id" ref="categ_gear"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_shop')])]"/>
    </record>
    <record id="prod_bat" model="product.template">
        <field name="name">Cricket Bat</field><field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">3499</field><field name="categ_id" ref="categ_gear"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_shop')])]"/>
    </record>
    <record id="prod_shoes" model="product.template">
        <field name="name">Sports Shoes</field><field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">2999</field><field name="categ_id" ref="categ_gear"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_shop')])]"/>
    </record>
    <record id="prod_tshirt" model="product.template">
        <field name="name">Club T-shirt</field><field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">999</field><field name="categ_id" ref="categ_gear"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_shop')])]"/>
    </record>

    <!-- Bar and cafe -->
    <record id="prod_coffee" model="product.template">
        <field name="name">Cold Coffee</field><field name="type">consu</field>
        <field name="list_price">250</field><field name="categ_id" ref="categ_bar"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_bar')])]"/>
    </record>
    <record id="prod_beer" model="product.template">
        <field name="name">Draught Beer</field><field name="type">consu</field>
        <field name="list_price">280</field><field name="categ_id" ref="categ_bar"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_bar')])]"/>
    </record>
    <record id="prod_sandwich" model="product.template">
        <field name="name">Veg Sandwich</field><field name="type">consu</field>
        <field name="list_price">180</field><field name="categ_id" ref="categ_bar"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_bar')])]"/>
    </record>
    <record id="prod_fries" model="product.template">
        <field name="name">Fries</field><field name="type">consu</field>
        <field name="list_price">150</field><field name="categ_id" ref="categ_bar"/>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('champions_club.pos_categ_bar')])]"/>
    </record>

    <!-- Opening stock -->
    <record id="quant_racket" model="stock.quant">
        <field name="product_id" eval="ref('champions_club.prod_racket').product_variant_id.id"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">12</field>
    </record>
    <record id="quant_balls" model="stock.quant">
        <field name="product_id" eval="ref('champions_club.prod_balls').product_variant_id.id"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">60</field>
    </record>
    <record id="quant_bat" model="stock.quant">
        <field name="product_id" eval="ref('champions_club.prod_bat').product_variant_id.id"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">8</field>
    </record>
    <record id="quant_shoes" model="stock.quant">
        <field name="product_id" eval="ref('champions_club.prod_shoes').product_variant_id.id"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">15</field>
    </record>
    <record id="quant_tshirt" model="stock.quant">
        <field name="product_id" eval="ref('champions_club.prod_tshirt').product_variant_id.id"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="quantity">40</field>
    </record>

    <!-- Low stock: native reordering rules flag anything at 5 or below -->
    <record id="orderpoint_racket" model="stock.warehouse.orderpoint">
        <field name="product_id" eval="ref('champions_club.prod_racket').product_variant_id.id"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">5</field><field name="product_max_qty">20</field>
    </record>
    <record id="orderpoint_balls" model="stock.warehouse.orderpoint">
        <field name="product_id" eval="ref('champions_club.prod_balls').product_variant_id.id"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">10</field><field name="product_max_qty">60</field>
    </record>
    <record id="orderpoint_bat" model="stock.warehouse.orderpoint">
        <field name="product_id" eval="ref('champions_club.prod_bat').product_variant_id.id"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">3</field><field name="product_max_qty">10</field>
    </record>
    <record id="orderpoint_shoes" model="stock.warehouse.orderpoint">
        <field name="product_id" eval="ref('champions_club.prod_shoes').product_variant_id.id"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">5</field><field name="product_max_qty">20</field>
    </record>
    <record id="orderpoint_tshirt" model="stock.warehouse.orderpoint">
        <field name="product_id" eval="ref('champions_club.prod_tshirt').product_variant_id.id"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">10</field><field name="product_max_qty">40</field>
    </record>
</odoo>
