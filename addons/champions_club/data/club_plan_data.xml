<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prices/discounts are demo values from the plan brief; owner edits them in UI, no code change needed. -->
    <record id="plan_gold" model="club.plan">
        <field name="name">Gold</field><field name="code">gold</field>
        <field name="court_price">0</field>
        <field name="shop_discount">15</field><field name="bar_discount">15</field>
        <field name="validity_days">365</field>
    </record>
    <record id="plan_silver" model="club.plan">
        <field name="name">Silver</field><field name="code">silver</field>
        <field name="court_price">300</field>
        <field name="shop_discount">10</field><field name="bar_discount">10</field>
        <field name="validity_days">365</field>
    </record>
    <record id="plan_junior" model="club.plan">
        <field name="name">Junior</field><field name="code">junior</field>
        <field name="court_price">200</field>
        <field name="shop_discount">5</field><field name="bar_discount">0</field>
        <field name="validity_days">365</field>
    </record>

    <record id="pricelist_walkin" model="product.pricelist">
        <field name="name">Walk-in</field>
    </record>
    <record id="pricelist_member" model="product.pricelist">
        <field name="name">Member</field>
    </record>
</odoo>
